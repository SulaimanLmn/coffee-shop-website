# Database (matches docker-compose.yml credentials)
DATABASE_URL="postgresql://coffee:coffee@localhost:5433/coffee_shop?schema=public"

# Midtrans Sandbox (https://dashboard.sandbox.midtrans.com > Settings > Access Keys)
MIDTRANS_SERVER_KEY="SB-Mid-server-xxx"
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY="SB-Mid-client-xxx"

# Public base URL of the app
APP_URL="http://localhost:3000"

# Pre-configured administrator account (created by `npm run db:seed`)
ADMIN_EMAIL="admin@brewhaven.test"
ADMIN_PASSWORD="admin12345"

# Secret used to sign session cookies (any long random string)
SESSION_SECRET="change-me-to-a-long-random-string"

# Optional: SMTP server for password reset emails. Leave SMTP_HOST empty for demo
# mode: no email is sent and the new-password page opens directly.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Brew Haven <no-reply@brewhaven.test>"
